    "generate-dictionaries": "node scripts/generate-dictionaries.js"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/opendyslexic": "^5.3.0",
    "jszip": "^3.10.1",
    "pdfjs-dist": "4.0.379",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.28",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.8.2",
    "vite": "^5.2.0",
    "vite-plugin-pwa": "^0.17.4"
  }
