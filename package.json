{
  "name": "penko-reader",
  "private": true,
  "repository": "github:NA-Ag/penko-reader",
  "description": "Penko Reader: an offline-first, privacy-respecting reading app with a cozy book reader, RSVP speed reader, training drills, and dictionary.",
  "author": "Penko Software <support@penkosoftware.org>",
